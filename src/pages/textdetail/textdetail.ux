    },
    private: {
        textLines: [],
        cardWidth: 330,
        cardRadius: 25,
        cardPadding: 15,
        textFontSize: 22,
        textContentWidth: 300,
        scrclass: ""
    },
    onInit() {
        this.doStyleAdjustTask()
        this.splitText()
    },
    splitText() {
        if (!this.text) {
            this.textLines = []
            return
        }
        // 按换行符拆分，每行作为一个独立的 text 元素
        this.textLines = this.text.split('\n')
    },
    doStyleAdjustTask() {
        const deviceInfo = global.DEVICE_INFO
        if (!deviceInfo) return

        // 336x480 屏幕
        if (deviceInfo.screenWidth <= 340) {
            this.cardWidth = 310
            this.cardRadius = 25
            this.cardPadding = 12
            this.textFontSize = 20
            this.textContentWidth = 286
        }
        // Band Pro 系列（380px左右）
        else if (deviceInfo.screenWidth <= 380) {
            this.cardWidth = 340
            this.cardRadius = 28
            this.cardPadding = 15
            this.textFontSize = 22
            this.textContentWidth = 310
        }
        // RW系列（中屏）
        else if (deviceInfo.screenShape == "rect") {
            this.cardWidth = 370
            this.cardRadius = 30
            this.cardPadding = 20
            this.textFontSize = 28
            this.textContentWidth = 330
        }
        // 圆屏系列
        else {
            this.cardWidth = 300
            this.cardRadius = 25
            this.cardPadding = 15
            this.textFontSize = 22
            this.textContentWidth = 270
        }
