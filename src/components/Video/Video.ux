<import name="online-image" src="@components/BetterOnlineImage/BetterOnlineImage.ux"></import>

<template>
  <div class="vid">
    <div class="loadedbox" @click="OpenVideo(video.bvid)" if="{{loadComp}}">
      <div style="{{vidinfo_style}}" class="vidinfo">
        <div class="vidpicture">
          <image class="vidpicture_img" style="width: {{vidpicture_style.width}} height: {{vidpicture_style.height}}"
            src="{{video.pic}}@{{onlineimg_width}}w_{{onlineimg_height}}h"></image>
        </div>
        <text class="vidtitle" if="{{!useColumnTitle}}">{{ video.title }}</text>
      </div>
      <text class="vidtitle_column" if="{{useColumnTitle}}">{{ video.title }}</text>
      <div class="vidstat">
        <text class="upinfo">UP：{{ video.owner.name }}</text>
        <div class="stat_view">
          <image class="stat_view_img" src="/common/playcounticon.png"></image>
          <text class="stat_view_text">
            {{ stat_view }}
          </text>
        </div>
      </div>
    </div>
    <text else class="compLoadingTip">视频加载中...</text>
  </div>
</template>

<script>
import router from "@system.router"

export default {
  props: ["video", "bvid"],
  data: {
    useColumnTitle: false,
    vidpicture_style: {
      width: "316px",
      height: "200px"
    },
    onlineimg_width: "316",
    onlineimg_height: "200",
    loadComp: false
  },
  computed: {
    stat_view() {
      return this.$app.$def.tools.formatNumber(this.video.stat.view)
    }
  },
  OpenVideo(bvid) {
    router.push({
      uri: "pages/video/videodetail",
      params: {bvid}
    })
  },
  SetOnlineImageSize(width, height) {
    this.vidpicture_style["width"] = width + "px"
    this.vidpicture_style["height"] = height + "px"
  },
  SetOnlineImageLoadSize(width, height) {
    this.onlineimg_width = width
    this.onlineimg_height = height
  },
  doStyleAdjustTask() {
    const deviceInfo = global.DEVICE_INFO
    const screenW = deviceInfo.screenWidth
    const screenH = deviceInfo.screenHeight

    const cardPadding = 30
    const availW = screenW - cardPadding

    const isRound = deviceInfo.screenShape !== "rect"
    const maxImgH = isRound
      ? Math.floor(screenH * 0.4)
      : Math.floor(screenH * 0.5)

    const ratio16x9 = Math.floor(availW * 9 / 16)
    const imgH = Math.min(ratio16x9, maxImgH)
    const imgW = availW

    const loadW = Math.floor(imgW * 0.85)
    const loadH = Math.floor(imgH * 0.85)

    this.useColumnTitle = true

    this.SetOnlineImageSize(imgW, imgH)
    this.SetOnlineImageLoadSize(loadW, loadH)

    this.vidinfo_style = { width: imgW + 'px' }
  },
  doVidObjectPatch() {
    if (!(this.video.pic.includes("http://") || this.video.pic.includes("https://"))) {
      this.video.pic = "https:" + this.video.pic
    }
  },
  async asyncInit() {
    if (!this.video) {
      this.video = await global.biliclient.getVideoInfoByBVID(this.bvid)
    }
    this.loadComp = true
    this.doVidObjectPatch()
    this.doStyleAdjustTask()
  },
  onInit() {
    this.asyncInit()
  }
}
</script>

<style lang="less">
@import "@less/global.less";

.vid {
  margin-top: 10px;
  padding: 15px 15px;
  border-radius: 25px;
  background-color: #262626af;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.loadedbox {
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.vidinfo {
  width: 306px;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.vidpicture {
  border-radius: 30px;
  background-color: rgba(255, 255, 255, 0);
  justify-content: center;
  align-items: center;
}

.vidpicture_img {
  border-radius: 30px;
  object-fit: scale-down;
}

.vidtitle {
  padding-left: 20px;
  width: 145px;
  font-size: 20px;
  font-weight: 600;
  text-overflow: ellipsis;
}

.vidtitle_column {
  margin-top: 10px;
  font-size: 20px;
  font-weight: 600;
  text-overflow: ellipsis;
  lines: 2;
}

.vidstat {
  padding: 6px 6px;
  margin-top: 5px;
  flex-direction: row;
  align-items: flex-start;
  min-width: 294px;
}

.upinfo {
  font-size: 14px;
  font-weight: 600;
  width: 200px;
  text-overflow: ellipsis;
}

.stat_view {
  position: absolute;
  right: 2px;
  align-items: center;
}

.stat_view_img {
  width: 20px;
  height: 15px;
  object-fit: scale-down;
}

.stat_view_text {
  font-size: 14px;
  font-weight: 600;
  margin-left: 5px;
}

.compLoadingTip {
  font-weight: 600;
  font-size: 18px;
}
</style>